# Persistent operational data. The default is .local/reliefrelay.db.
RELIEFRELAY_DATABASE=.local/reliefrelay.db

# Set a long random value when the API is reachable by other machines.
RELIEFRELAY_API_TOKEN=

# Local whisper.cpp assets provisioned by scripts/setup_whisper_runtime.py.
RELIEFRELAY_WHISPER_BINARY=
RELIEFRELAY_WHISPER_MODEL=models/whisper/ggml-tiny.en-q5_1.bin
# Omit to auto-tune to available CPUs, capped at 6 for stable tail latency.
# RELIEFRELAY_WHISPER_THREADS=6
RELIEFRELAY_WHISPER_TIMEOUT_SECONDS=120

# Protect CPU-only inference from overload.
RELIEFRELAY_MAX_CONCURRENT_INFERENCE=1
RELIEFRELAY_QUEUE_TIMEOUT_SECONDS=5

# Similar reports only merge into an open incident inside this window.
RELIEFRELAY_DEDUPLICATION_WINDOW_HOURS=24
